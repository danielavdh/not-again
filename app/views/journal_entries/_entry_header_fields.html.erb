<div class="field flex controls">
	<div>
		<%= f.label :entry_date, t("attrs.date")+  ": " %>
		<span class="error_message">
			<%= entry&.errors[:entry_date].to_sentence %>
		</span>
		<%= f.date_field :entry_date,
				id: :journal_entry_entry_date %>
	</div>
	<div>
		<%= f.label :journal_reference, t("attrs.je_ref")+  ": " %>
		<span class="error_message">
			<%= entry&.errors[:journal_reference].to_sentence %>
		</span>
		<%= f.text_field :journal_reference,
				id: :journal_entry_journal_reference,
				placeholder: t("attrs.je_placeholder") %>
	</div>
	<div>
		<%= f.label :memo, t("attrs.memo")+  ": " %>
		<span class="error_message">
			<%= entry&.errors[:memo].to_sentence %>
		</span>
		<%= f.text_field :memo,
				id: :journal_entry_memo %>
	</div>
	<%# Closing a year is a journal-entry concept. This partial is shared with the
	    bank and transfer forms — the guided path, which exists so that its users
	    never have to meet it — so the caller opts in. %>
	<%# Just the tick. The period is derived — it ends on the entry date and runs a
	    year back — and the result is shown as "closed up to" on the dashboard,
	    the same place beginners see it. %>
	<% if local_assigns[:allow_closing] %>
		<div>
			<%= f.check_box :closing_entry, id: :journal_entry_closing_entry %>
			<%= f.label :closing_entry, t("attrs.closing_entry") %>
		</div>
	<% end %>
</div>
