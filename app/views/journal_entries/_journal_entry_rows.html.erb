<% journal_entries.each do |je| %>
  <tr class="<%= cycle('list-line-odd', 'list-line-even') %>">
    <td class="no-phone">
      <%= je.id %>
      <% if local_assigns[:cross_entity_je_ids]&.include?(je.id) %>
        <span class="ce-linked-cue" title="<%= t('entities.cross_entity.linked') %>" aria-label="<%= t('entities.cross_entity.linked') %>">
          <svg><use xlink:href='#te_intlink'></use></svg>
        </span>
      <% end %>
    </td>
    <td><%= format_date(je.entry_date) %></td>
    <td><%= balance_account[je.id] %></td>
    <td class="no-phone"><%= je.memo %></td>
    <td class="no-phone"><%= je.journal_reference %></td>
    <td class="right">
      <% credit = credit_sums[je.id] %>
      <%= format_amount(credit&.dig(:amount) || 0, credit_currency[je.id]) %>
    </td>
    <td class="no-phone">
      <% if je.posted? %>
        <span class="badge-posted"><%= t("attrs.posted") %></span>
      <% else %>
        <span class="badge-draft"><%= t("attrs.draft") %></span>
      <% end %>
    </td>
    <td class="actions no-print no-phone">
      <%# A generated year-end entry is maintained by the year-end flow — no edit, no copy. Reopening the year is the way back. %>
      <% unless local_assigns[:app_owned_close_ids]&.include?(je.id) %>
        <%= link_to edit_journal_entry_path(je), class: "backend_link button green" do %>
          <span class="big-screen"><%= t("crud.edit") %></span>
          <svg class="small-screen"><use xlink:href='#edit'></use></svg>
        <% end %>
        <%= link_to duplicate_journal_entry_path(je), class: "backend_link button green" do %>
          <span class="big-screen"><%= t("crud.copy") %></span>
          <svg class="stroke small-screen"><use xlink:href='#copy'></use></svg>
        <% end %>
      <% end %>
      <%= link_to journal_entry_path(je), class: "backend_link button green" do %>
        <span class="big-screen"><%= t("crud.view") %></span>
        <svg class="small-screen"><use xlink:href='#view'></use></svg>
      <% end %>
    </td>
  </tr>
<% end %>
