<% new_record = !record.persisted? %>

<div class="field">
  <%= form.label :password, new_record ? t("shared.password_fields.password") : t("shared.password_fields.password_new") %>
  <span class="error_message"><%= record.errors[:password].to_sentence %></span><br />
  <%= form.password_field :password,
                          id: "#{id_prefix}_password",
                          required: required,
                          minlength: 8 %>
</div>

<div class="field">
  <%= form.label :password_confirmation, t("shared.password_fields.password_confirmation") %>
  <span class="error_message"><%= record.errors[:password_confirmation].to_sentence %></span><br />
  <%= form.password_field :password_confirmation,
                          id: "#{id_prefix}_password_confirmation",
                          required: required %>
</div>
