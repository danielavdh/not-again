<% if pf.object.account_id == account_id %>
	<%# Bank posting: render as hidden fields only, no visible row %>
	<tr class="posting-row hidden">
	  <%= pf.hidden_field :id %>
	  <%= pf.hidden_field :entry_type, data: { bank_entry_type: true } %>
	  <%= pf.hidden_field :account_id %>
	  <%= pf.hidden_field :currency %>
	</tr>
<% else %>

	<tr class="posting-row <%= cycle('list-line-odd', 'list-line-even') %>">
	  <%= pf.hidden_field :id %>
	  <%= pf.hidden_field :entry_type,
	  				  value: entry_type == 'deposit' ? 'credit' : 'debit',
					  class: 'posting-type',
	                  data: { side_field: true } %>
	  <%= pf.hidden_field :currency, value: currency, class: 'posting-currency' %>
	  <%= pf.hidden_field :deduction_pair_id, class: 'posting-deduction-pair-id' %>
	  <%= pf.hidden_field :cross_entity_link_id, class: 'posting-cross-entity-link-id' %>
	  <%= pf.hidden_field :deduction_percentage, class: 'posting-deduction-pct-field' %>

	  <td>
	    <%= pf.select :account_id,
					  options_for_select(@account_options, pf.object.account_id),
	                  { include_blank: t("attrs.account_blank") },
	                  class: 'form-select posting-account',
	                  aria: { label: t("jargon.account") },
                  data: { tomselect: true, tomselect_placeholder: t("attrs.tom_blank") } %>
	    <span class="error_message"><%= pf.object.errors[:account_id].to_sentence %></span>
	  </td>

	  <td class="split-col">
	    <%# A 601 gift bridge is not splittable — no % button. %>
	    <% if pf.object.cross_entity_link_id.blank? %>
	      <button type="button" class="split-btn" data-action="open-split-modal"
	              data-deduction-pct="<%= pf.object.deduction_percentage || pf.object.account&.deduction_percentage %>"><%= pf.object.deduction_percentage ? "#{pf.object.deduction_percentage}%" : "%" %></button>
	    <% end %>
	  </td>

	  <% expected_type = entry_type == 'deposit' ? 'credit' : 'debit' %>
	  <td class="input-cell">
	    <%# A 601 gift bridge amount is set only via the modal — locked here. %>
	    <%= pf.text_field :amount_display,
	                  value: pf.object.amount_display_formatted(expected_type),
	                  class: 'posting-amount right',
	                  inputmode: 'decimal',
	                  readonly: pf.object.cross_entity_link_id.present?,
	                  placeholder: pf.object.errors[:amount_display].first,
	                  aria: { label: t("attrs.amount") },
	                  data: { amount_field: true } %>
	    <span class="error_message"><%= pf.object.errors[:amount_display].to_sentence %></span>
	  </td>
	  <td class="input-cell">
	    <%= pf.text_field :description, aria: { label: t("attrs.description") } %>
	  </td>
	  <td class="input-cell no-phone">
	    <%= pf.text_field :reference, aria: { label: t("attrs.reference") } %>
	  </td>
  	  <td class="posting-receipt no-phone">
		<%= render partial: 'receipts/posting_receipt_widget',
		           locals: { pf: pf } %>
  	  </td>
	  <td class="input-cell">
	    <%= pf.check_box :_destroy, class: 'posting-destroy', aria: { label: t("crud.remove_posting") } %>
	  </td>
	</tr>
<% end %>

