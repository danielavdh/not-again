<div id="new_edit_view">

    <%= render partial: "shared/flash" %>

    <% if @admin.errors.any? %>
    <p class="error_message"><%= t(".errors_on_page") %></p>
    <% end %>

    <h1><%= @mode == :invite ? t(".grant_access") : t(".new_h1") %></h1>

    <%# The page does two jobs and the email picks which — so it says so, rather
        than leaving it to be guessed from the heading. %>
    <p class="info"><%= t(".mode_hint") %></p>

    <%= render 'form', admin: @admin %>

    <div class="crud_navigation">
    <% if sudo? %>
        <%= link_to t(".index"), admins_path, class: "backend_link" %>
    <% else %>
        <%= link_to t("crud.back"), admin_path(current_admin), class: "backend_link" %>
    <% end %>
    </div>

</div>
