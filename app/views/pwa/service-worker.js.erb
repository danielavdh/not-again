const CACHE_NAME = "v1";
const URLS_TO_CACHE = [
  "/",
  "<%= asset_path 'application.css' %>",
  "<%= asset_path 'application.js' %>",
  "<%= asset_path 'welcome_index.jpg' %>",
  "<%= asset_path 'welcome_index_phone.jpg' %>",
  "<%= asset_path 'welcome_index_pwa.jpg' %>",
  "/favicon.ico",
  "<%= asset_path 'favicon.png' %>",
  "<%= asset_path 'apple-touch-icon.png' %>",
  "<%= asset_path 'android-chrome-192x192.png' %>",
  "<%= asset_path 'android-chrome-512x512.png' %>",
  "/manifest.json",
];

self.addEventListener("install", (event) => {
  // cache.addAll is all-or-nothing — one 404 (a missing icon, say) would
  // otherwise fail the whole install and leave nothing cached at all. Each
  // URL is added on its own instead, so one bad entry costs only itself.
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => {
      return Promise.all(
        URLS_TO_CACHE.map((url) =>
          cache.add(url).catch((err) => console.warn("Not cached:", url, err))
        )
      );
    })
  );
});

self.addEventListener("fetch", (event) => {
  // Only handle GET requests
  if (event.request.method !== "GET") return;

  event.respondWith(
    caches.match(event.request).then((response) => {
      // Return cached response if found
      if (response) {
        return response;
      }
      
      // Otherwise fetch from network
      return fetch(event.request).then((networkResponse) => {
        return networkResponse;
      }).catch(() => {
        // If network fails (offline) and not in cache
        // If the request is for the homepage (navigation), return the cached root
        if (event.request.mode === 'navigate') {
             return caches.match('/');
        }
      });
    })
  );
});
