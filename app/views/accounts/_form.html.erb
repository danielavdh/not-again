<%# fixed_type present = the add-account-on-the-fly mode: entity and type are fixed, the code is pre-filled, tax is hidden. Normal new/edit pass no locals and are unaffected. %>
<% ce = local_assigns[:fixed_type].present? %>
<%= form_with model: account,
			  local: true,
			  id: "#{action_name}_account",
			  class: "form_account"  do |f| %>

	<div class="field">
	    <%= f.label :code, t("attrs.code") %>
	    <% if ce %><span class="field-instruction"><%= t("entities.cross_entity.code_hint") %></span><% end %>
	    <span class="error_message">
	    <%= account&.errors[:code].to_sentence %>
	    </span><br />
	    <%= f.text_field :code,
	                id: :account_code,
	                maxlength: 6,
	                placeholder: t("attrs.code_placeholder"),
	                autofocus: !account.persisted?,
	                required: true %>
	</div>

	<div class="field">
	    <%= f.label :name, t("attrs.name") %>
	    <span class="error_message">
	    <%= account&.errors[:name].to_sentence %>
	    </span><br />
	    <%= f.text_field :name,
	                id: :account_name,
	                placeholder: (name_placeholder if ce),
	                required: true %>
	</div>

	<div class="field flex">
		<div>
	    <%= f.label :account_type, t(".type") %>
	    <span class="error_message">
	    <%= account&.errors[:account_type].to_sentence %>
	    </span><br />
			<% if ce %>
				<span class="fixed-value"><%= t("jargon.#{fixed_type}").humanize %></span>
				<%= f.hidden_field :account_type, value: fixed_type %>
			<% else %>
				<%= f.select :account_type,
						accessible_accounts.account_types.keys.map { |type| [t("jargon.#{type}").humanize, type] },
						{},
						id: :account_account_type %>
			<% end %>
		</div>

		<% if ce %>
		<div>
	    <%= f.label :currency, t(".currency") %><br />
			<span class="fixed-value"><%= fixed_currency.presence || "—" %></span>
			<%= f.hidden_field :currency, value: fixed_currency %>
		</div>
		<% elsif !(account.persisted? && account.account_type.in?(%w[income expense personal])) %>
		<div>
	    <%= f.label :currency, t(".currency") %>
	    <span class="error_message">
	    <%= account&.errors[:currency].to_sentence %>
	    </span><br />
			<%# ⚠️ The FULL active list: this and the exchange rate form are the two places a currency ARRIVES, so narrowing it would make a new one unreachable. Grouped, so the ones already in use come first. %>
			<%= f.select :currency,
									currency_options_for_account(account&.currency),
									{ include_blank: true },
									id: :account_currency %>
		</div>
		<% end %>

		<div>
	    <%= f.label :parent_id, t(".parent") %>
	    <span class="error_message">
	    <%= account&.errors[:parent_id].to_sentence %>
	    </span><br />
			<%= f.select :parent_id, 
					@parent_options, 
					{ include_blank: t("attrs.parent_sel") }, 
					{ id: :account_parent_id, 
					  data: { account_type: @account.account_type }} %>
		</div>
	</div>


	<%# Never translated — it is what the bookkeeper wrote. %>
	<div class="field">
	    <%= f.label :description, t("attrs.description") %>
	    <span class="error_message">
	    <%= account&.errors[:description].to_sentence %>
	    </span><br />
	    <%= f.text_area :description,
	                id: :account_description,
					class: "less_height",
	                placeholder: t("attrs.description_placeholder"),
	                rows: 2 %>
	</div>

	<div class="field">
	    <%= f.label :active %>
	    <span class="error_message">
	    <%= account&.errors[:active].to_sentence %>
	    </span><br />
			<%= f.check_box :active, 
					id: :account_active %>
	</div>

	<% if @tax_category_options.present? && !ce %>
	  <div class="field">
	    <% if account.persisted? && account.postings.exists? %>
	      <p class="field-instruction tax_reassign_note"><%= t("tax.reassign_note") %></p>
	    <% end %>
	    <%= label_tag :account_tax_category_combined, t("tax.category_field") %>
	    <span class="error_message">
	      <%= ((account&.errors&.[](:tax_category_key) || []) + (account&.errors&.[](:tax_scheme) || [])).to_sentence %>
	    </span><br />
	    <%= select_tag "account[tax_category_combined]",
	                grouped_options_for_select(@tax_category_options, account.tax_category_combined),
	                include_blank: t("tax.category_none"),
	                data: { tax_note: true },
	                id: :account_tax_category_combined %>
	  </div>
	<% end %>

  <% if ce %>
    <%# Keeps submit and cancel together; the form's normal .actions would merge with .crud_navigation. %>
    <div class="split-actions">
      <%= f.submit t(".create"), class: "button" %>
      <button type="button" class="button add-account-cancel"><%= t("crud.cancel") %></button>
    </div>
  <% else %>
    <div class="actions">
      <%= f.submit (account.persisted? ? t(".update") : t(".create")) %>
    </div>
  <% end %>

<% end %>
