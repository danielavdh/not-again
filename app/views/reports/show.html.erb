<% content_for :title, @report.name %>

<div class="backend_table report show">

  <h2><%= @report.name %><%= @short_version ? t(".short_v") : t(".long_v") %>
    <span><%=l @report.start_date, :format => :short_date %> - <%=l @report.end_date, :format => :short_date %></span>
  </h2>

  <%= render partial: 'shared/flash' %>

  <div id="report-container">
    <%= render(@report.tax_report? ? "tax_report" : "custom_report") %>
  </div>

  <dialog id="edit-modal" class="edit-modal">
    <div class="edit-modal-content">
      <button type="button" class="edit-modal-close" aria-label="<%= t('crud.close', default: 'Close') %>">&times;</button>
      <iframe id="edit-modal-frame" src="about:blank"></iframe>
    </div>
  </dialog>

</div>


<div class="crud_navigation">
	<%= link_to t("crud.dashboard"),
		dashboard_path,
		class: "backend_link button green no-halfpad" %>

	<%= link_to t("crud.back_to", name: @report.report_group.display_name),
		report_group_path(@report.report_group),
		class: "backend_link button no-phone" %>

	<%= link_to report_path(@report, currency: @display_param, version: 'short'),
			class: "button #{@short_version ? 'yellow' : 'green'}",
			data: { version: 'short' } do %>
		<span class="big-screen"><%= t(".short") %></span>
		<svg class="small-screen stroke s30"><use xlink:href='#short'></use></svg>
	<% end %>

	<%= link_to report_path(@report, currency: @display_param, version: 'long'),
			class: "button #{@short_version ? 'green' : 'yellow'}",
			data: { version: 'long' } do %>
		<span class="big-screen"><%= t(".long") %></span>
		<svg class="small-screen stroke s30"><use xlink:href='#long'></use></svg>
	<% end %>
	
	<%= link_to t("crud.csv"),
			report_path(@report, 
			currency: @display_param, 
			version: @short_version ? 'short' : 'long', 
			format: :csv),
			class: 'button green',
			data: { sure: t("crud.csv_confirm") } %>
	
	<%= button_to t(@report.tax_report? ? "reports.tax_export_email" : "reports.export_email"),
			tax_export_report_path(@report, currency: @display_currency),
			method: :post,
			class: 'button green' %>
	
	<button id="print-button" class="button green print-report">
		<span class="bigger-screen"><%= t("crud.print") %></span>
		<svg class="tiny-screen stroke s15"><use xlink:href='#print'></use></svg>
	</button>
</div>
