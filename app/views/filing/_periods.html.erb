<%# locals: (obligations:, entity:, scheme:, authority:, report_periods:) %>

  <h2><%= t("filing.submissions_heading") %></h2>
  <table>
    <thead>
      <tr>
        <th><%= t("filing.period") %></th>
        <th><%= t("filing.due") %></th>
        <th><%= t("filing.status") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% obligations.each do |ob| %>
        <tr class="<%= cycle('list-line-odd', 'list-line-even') %>">
          <td><%= l(ob[:start_date], format: :short_date) %> &ndash; <%= l(ob[:end_date], format: :short_date) %></td>
          <td><%= l(ob[:due_date], format: :short_date) %></td>
          <td><%= ob[:status] == Filing::Base::STATUS_FULFILLED ? t("filing.status_fulfilled") : t("filing.status_open") %></td>
          <td>
            <% if ob[:status] == Filing::Base::STATUS_FULFILLED %>
              <button class="backend_link button"
                      data-action="view-submission"
                      data-url="<%= filing_view_entity_path(entity, scheme: scheme, period_id: ob[:period_id]) %>"
                      data-modal="filing-submission-modal">
                <%= t("filing.view_submission") %>
              </button>
            <% elsif ob[:end_date] <= Date.current %>
              <%= button_to t("filing.submit", authority: authority),
                            filing_submit_entity_path(entity),
                            params: { scheme: scheme, period_id: ob[:period_id] },
                            data: { sure: "#{t('filing.submit_confirm', authority: authority)} #{l(ob[:start_date], format: :short_date)} – #{l(ob[:end_date], format: :short_date)}?" },
                            class: "backend_link button #{ob[:overdue] ? 'red' : 'green'}" %>
            <% end %>
            <%# What is in this figure? The submission shows totals; a report shows
                the accounts behind them, and can be exported. Offered, never
                made automatically — see FilingController#report. %>
            <%= button_tag t("filing.report.add"), type: "button",
                           class: "backend_link button",
                           data: { action: "open-modal",
                                   modal: "filingReportModal-#{ob[:period_id]}" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# The dates the report will carry, worked out once by the connector from the
      obligations it already has — asking per row would be an API call per row. %>
  <% obligations.each do |ob| %>
    <%# Falls back to the obligation's own start: before 2025-26 a submission
        covers just the quarter, and that is also the honest answer if the
        cumulative range could not be worked out. %>
    <%= render "filing/add_report_modal", entity: entity, scheme: scheme, ob: ob,
                                              period_start: (report_periods[ob[:period_id]] || []).first || ob[:start_date] %>
  <% end %>
