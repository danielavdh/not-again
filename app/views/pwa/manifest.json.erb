{
  "name": "Not Again",
  "short_name": "Not Again",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/android-chrome-512x512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "description": "Bookkeeping. Not again.",
  "theme_color": "#4a5568",
  "background_color": "#4a5568",
  "share_target": {
    "action": "<%= share_receive_receipts_path(locale: nil) %>",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "scan",
          "accept": ["image/jpeg", "image/png", "image/heic", "application/pdf"]
        }
      ]
    }
  }
}
