<%# Locals: entity, groups, allow_create. Posts to the ENTITY update with group_only=1, so a full-access admin can set only the family. A plain path, not a host-qualified URL — posting across hosts is what Rails' CSRF origin check refuses.

    Two forms, never both: a grouped entity gets only the leave checkbox (joining is one-way, see Entity#family_ties_do_not_block_leaving); an ungrouped one gets a picker, which can also create a family when another ungrouped entity exists to form it with. Never pre-selected, so joining is always deliberate. %>
<% if entity.entity_group_id? %>
  <%= form_with url: entity_path(entity), method: :patch, class: "form_entity" do |f| %>
    <%= hidden_field_tag :group_only, 1 %>
    <p><%= entity.entity_group.name %></p>
    <label>
      <%= check_box_tag "entity[leave_family]", "1" %>
      <%= t("entities.group.leave_the_family") %>
    </label>
    <%= f.submit t("entities.group.save"), class: "button green" %>
  <% end %>
<% else %>
  <%= form_with url: entity_path(entity), method: :patch, class: "form_entity" do |f| %>
    <%= hidden_field_tag :group_only, 1 %>
    <% if allow_create %>
      	<select id="entity_group_value" name="entity[group_value]"
            data-tomselect="true" data-tomselect-create="true"
            data-tomselect-placeholder="<%= t('entities.group.placeholder') %>">
      	    <option value=""><%= t("entities.group.none") %></option>
          <% groups.each do |group| %>
            <option value="<%= group.id %>"><%= group.name %></option>
          <% end %>
        </select>
    <% else %>
      <select name="entity[group_value]">
        <option value=""><%= t("entities.group.choose") %></option>
        <% groups.each do |group| %>
          <option value="<%= group.id %>"><%= group.name %></option>
        <% end %>
      </select>
    <% end %>
    <%= f.submit t("entities.group.save"), class: "button green" %>
  <% end %>
<% end %>
