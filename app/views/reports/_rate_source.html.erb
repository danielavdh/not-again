<%# Which published series produced the converted column. locals: (sources:, selectable:). WHEN it shows is Reports::CurrencyColumns.name_source?; only the audience is decided here — full-access pro, the same argument as the journal entry view. The CSV exports carry it for everyone, because a file outlives whoever downloaded it. %>
<% if current_admin.full_access_pro? && name_rate_source?(sources, selectable: selectable) %>
  (<% sources.each_with_index do |source, i| %>
    <%= " · " if i.positive? %>
    <% own   = source == "manual" %>
    <% label = own ? t("reports.rate_source.own") : RateSourceConfig.short_label_for(source) %>
    <% title = own ? t("reports.rate_source.own_title")
                   : t("reports.rate_source.title", label: RateSourceConfig.label_for(source)) %>
    <abbr title="<%= title %>"><%= label %></abbr>
  <% end %>)
<% end %>
