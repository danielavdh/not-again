<div class="wrap">

  <nav>
    <div class="brand"><%= link_to "not-again", root_path %></div>
    <div class="navmeta">
      <%= link_to t(".nav_features"), "#what" %>
      <%# Guarded like the CTA below it: an installation with no demo seeded should
          not offer a door that opens onto a page with no way in. %>
      <%= link_to t(".nav_demo"), demo_path if demo_available? %>
      <%= link_to "github ↗", REPO_URL, class: "gh", rel: "noopener" if REPO_URL %>
      <%= link_to t(".login"), new_session_path, class: "gh" %>
    </div>
  </nav>

  <header class="hero">

    <div class="eyebrow">
      <%= safe_join(Array(t(".eyebrow")).map { |word| tag.span(word) }) %>
      <%= render "welcome/langs" %>
    </div>

    <h1><%= t(".title_html") %></h1>

    <p class="subline"><%= t(".subline_html",
         word: tag.span(tag.span("boring", class: "rot", id: "rot"), class: "rotbox")) %></p>

    <p class="lede"><%= t(".lede_html") %></p>

    <div class="cta-row">
      <%= link_to t(".cta_primary"), new_session_path, class: "btn btn-primary" %>
      <%= link_to t(".cta_demo"), demo_path, class: "btn btn-ghost" if demo_available? %>
      <span class="cta-note"><%= t(".cta_note") %></span>
    </div>
  </header>

  <div class="ledger">
    <div class="cell"><div class="k"><%= t(".ledger_currencies") %></div><div class="v">∞</div></div>
    <div class="cell"><div class="k"><%= t(".ledger_languages") %></div><div class="v">∞</div></div>
    <div class="cell"><div class="k"><%= t(".ledger_licence") %></div><div class="v licence">AGPL</div></div>
    <div class="cell"><div class="k"><%= t(".ledger_excitement") %></div><div class="v">0<small> / 10</small></div></div>
  </div>

  <section class="feat" id="what">
    <div class="sec-head"><%= t(".features_heading") %></div>
    <div class="rows">
      <div class="row">
        <div class="num">01<span class="tier"><%= t(".tier_admin") %></span></div>
        <h3><%= t(".f1_title") %></h3>
        <p><%= t(".f1_body") %></p>
      </div>
      <div class="row">
        <div class="num">02<span class="tier"><%= t(".tier_admin") %></span></div>
        <h3><%= t(".f2_title") %></h3>
        <p><%= t(".f2_body") %></p>
      </div>
      <div class="row">
        <div class="num">03<span class="tier"><%= t(".tier_admin") %></span></div>
        <h3><%= t(".f3_title") %></h3>
        <p><%= t(".f3_body") %></p>
      </div>
      <div class="row">
        <div class="num">04<span class="tier"><%= t(".tier_admin") %></span></div>
        <h3><%= t(".f4_title") %></h3>
        <p><%= t(".f4_body") %></p>
      </div>
      <div class="row">
        <div class="num">05<span class="tier"><%= t(".tier_sysadmin") %></span></div>
        <h3><%= t(".f5_title") %></h3>
        <p><%= t(".f5_body") %></p>
      </div>
      <div class="row">
        <div class="num">06<span class="tier"><%= t(".tier_dev") %></span></div>
        <h3><%= t(".f6_title") %></h3>
        <p><%= t(".f6_body") %></p>
      </div>
      <div class="row">
        <div class="num">07</div>
        <h3><%= t(".f7_title_html") %></h3>
        <p><%= t(".f7_body_html") %></p>
      </div>
      <div class="row">
        <div class="num">08<span class="tier"><%= t(".tier_dev") %></span></div>
        <h3><%= t(".f8_title") %></h3>
        <p><%= t(".f8_body_html") %></p>
      </div>
    </div>
  </section>

  <div class="band" id="open">
    <div>
      <h2><%= t(".band_heading_html") %></h2>
      <p><%= t(".band_note") %></p>
    </div>
    <%= link_to t(".band_cta"), REPO_URL, class: "btn", rel: "noopener" if REPO_URL %>
  </div>

  <footer>
    <div class="sig"><%= t(".footer_sig") %></div>
    <div class="contrast">
      <% if REPO_URL %>
        <%= link_to "github", REPO_URL, rel: "noopener" %> ·
        <%= link_to t(".footer_docs"), "#{REPO_URL}#readme", rel: "noopener" %> ·
      <% end %>
      <%= render "welcome/contrast_toggle" %> ·
      <%= link_to service_host, root_path %>
    </div>
  </footer>

</div>
