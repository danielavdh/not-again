<table class="backend_show report_overview <%= orphaned %>">
	<thead>
		<tr class="entity-title">
			<th>
				<%# The entity, never the signed-in admin. %>
				<span class="admin-name"><%= entity.name %> - <%= entity.code %></span>
			</th>
			<th>
				<div>
	  			<%# Open year: a link to the close screen. Closed: a button that posts. %>
	  			<% if current_admin.full_access? || sudo? || current_admin.may_open_entry_forms? %>
	  			  <% if last_closed_on(entity).present? %>
	  			    <%= button_to t("reports.year_end.button"),
	  			  			create_year_end_reports_path(entity_id: entity.id),
	  			  			method: :post,
	  			  			data: { sure: t("reports.year_end.confirm_generic", entity: entity.name) },
	  			  			class: "backend_link button green" %>
	  			  <% else %>
	  			    <%= link_to t("reports.year_end.button"),
	  			  			new_year_end_reports_path(entity_id: entity.id),
	  			  			class: "backend_link button green" %>
	  			  <% end %>
	  			  <% if last_closed_on(entity).present? %>
	  			    <%= link_to t("reports.year_end.closed_up_to", date: l(last_closed_on(entity))),
	  			          new_year_end_reports_path(entity_id: entity.id),
	  			          class: "closed-up-to" %>
	  			  <% end %>
	  			<% end %>
				</div>
			</th>
		</tr>
		<%# Tax actions belong to the business, and this partial is the only place an entity reliably appears — entities#index is sudo-only. %>
		<%# The demo too: the link is a GET and everything it can submit is refused by require_write_access. %>
		<% if sudo? || can_edit_for_entity?(entity.code) || current_admin.may_open_entry_forms? %>
		  <tr class="entity-tax">
		    <th class="firstCell"><%= t("entities.edit_tax.link") %>:</th>
		    <th>
		      <%# "Tax Setup" only while there is none; after that the row already says Tax. %>
		      <%= link_to (Array(entity.tax_schemes).empty? ?
		                     t("entities.edit_tax.setup") : t("crud.edit")),
		            edit_tax_entity_path(entity),
		            class: "backend_link button green" %>

		      <% offers = entity.filing_offers %>
		      <% offers[:connect].each do |offer| %>
		        <%# New tab, as on the tax setup page: abandoning the authority's login leaves no way back — Back re-runs filing#connect and bounces out again. %>
		        <%= link_to t("filing.connect", authority: offer[:authority]),
		              filing_connect_entity_path(entity, connector: offer[:connector],
		                                             taxpayer_id: offer[:taxpayer].id),
		              target: "_blank", rel: "noopener",
		              class: "backend_link button green" %>
		      <% end %>
		      <% offers[:submit].each do |offer| %>
		        <% if (filing_path = scheme_filing_path(entity, offer[:scheme])) %>
		          <%= link_to t("filing.scheme_submission", scheme: offer[:name]),
		                filing_path, class: "backend_link button green" %>
		        <% end %>
		      <% end %>
		    </th>
		  </tr>
		<% end %>
		<%# Not a report you open, a file you take — so it sits with Tax rather than in the report-groups list. See docs/known-limitations.md §8.

		    Gated on show_general_reports: a grouped member's archive is the FAMILY's, one per family, not one per member. %>
		<% if local_assigns.fetch(:show_general_reports, true) %>
		<tr class="entity-downloads">
		  <th class="firstCell"><%= t(".downloads") %>:</th>
		  <th>
		    <div class="flex space-between">
		      <%= button_to Date.current.strftime("%y-%m-%d"),
		            create_archive_reports_path(entity_id: entity.id),
		            method: :post, class: "backend_link button green" %>
		      <% recent = recent_archives(entity) %>
		      <% recent[:entries].each do |archived| %>
		        <%= link_to archived.end_date.strftime("%y-%m-%d"),
		              download_archive_reports_path(key: archived.key),
		              class: "backend_link button blue" %>
		      <% end %>
		      <% if recent[:more] %>
		        <%= link_to t(".more_downloads"), reports_path, class: "backend_link button" %>
		      <% end %>
		    </div>
		  </th>
		</tr>
		<% end %>
	    <tr>
		    <% if entity.report_groups.empty? %>
	        	<th class="firstCell"><%= t(".no_groups") %></th>
	        	<th></th>
		    <% else %>
	        	<th class="firstCell"><%= t(".groups") %>:</th>
	        	<th><%= t(".reports") %>:</th>
		    <% end %>
	    </tr>
	</thead>
	
	<tbody>
	  <%# Tax groups first, then custom, then the add-group form. %>
	  <% report_groups = Array(report_groups).sort_by { |g| [ g.tax_report? ? 0 : 1, g.position.to_i ] } %>
	  <% report_groups.each do |group| %>
	    <tr class="<%= cycle('list-line-odd', 'list-line-even') %>">
	    	<td class="firstCell">
				<div class="flex">
	    	  		<span class="group-actions">
				  		<%# Nothing here is editable: the name is declared by the scheme and the accounts follow the tagging. Assign them on the group's show page, or on the account's own edit page. %>
				  		<% if group.tax_report? %>
				  		<span class="group-kind"><%= t("reports.overview.scheme") %></span>
				  		<% else %>
				  		<%= link_to edit_report_group_path(group),
								class: "backend_link button green" do %>
							<span class="big-screen"><%= t("crud.edit") %></span>
				  			<svg class="small-screen">
								<use xlink:href='#edit'></use>
							</svg>
				  		<% end %>
				  		<% end %>
	     				<%# A tax group belongs to its scheme: it appears when the scheme is subscribed to and goes when it is dropped. Deleting it by hand would leave the scheme nowhere to show its accounts. %>
	     				<%= button_to t("crud.delete"),
	     				  		report_group_path(group),
	     				  		method: :delete,
	     						class: "backend_link button green",
	     				  		data: {sure: t("crud.sure")} if group.deletable? %>
	    	  		</span>
	    	  		<%# display_name, not name: a tax group's name comes from its scheme and is never translated. %>
	    	  		<%= link_to group.display_name,
	     						report_group_path(group),
	     						class: "group-name backend_link button" %>
				</div>
	    	</td>
	    	<td>
				<div class="flex">
					<span class=report-list>
					<% group.reports.each do |report| %>
	    	    		<%= link_to report.name, 
	     					report_path(report), 
	     					class: "backend_link button blue" %>
	    	  		<% end %>
					</span>
					<span class="flex1"></span>
	     			<%= button_tag type: "button",
	     				data: { action: "open-modal",
								modal: "reportModal-#{group.id}" },
	     				class: "button green" do %>
	     				<span class="big-screen"><%= t(".add_report") %></span>
	     				<svg class="small-screen stroke s60">
	     					<use xlink:href='#add'></use>
	     				</svg>
	     			<% end %>
	    	</td>
	    </tr>
	     
	  <% end %>
	
	  	<!-- New Group Form -->
		<tr class="<%= cycle('list-line-odd', 'list-line-even') %>">
			<td class="firstCell">
		  	  	<%= form_with model: ReportGroup.new, 
					    url: entity_report_groups_path(entity) do |f| %>
					<span class="flex">
						<%= f.button class: "backend_link button green" do %>
						    <span class="big-screen"><%= t(".add_group") %></span>                 				   <svg class="small-screen stroke s60">                                          			<use xlink:href='#add'></use>                                      			  </svg>                                                                     	<% end %>
		    			<%= f.text_field :name,
			  				aria: { label: t(".group_placeholder") },
			  				placeholder: t(".group_placeholder"),
							required: true %>
					</span>
		  		<% end %>
			</td>
			<td></td>
		</tr>

	    <% if local_assigns.fetch(:show_general_reports, true) %>
	    <tr>
	        <%# All three call Entity.family_codes_for, so clicking one from a single member produces the WHOLE family's report — a trial balance only balances at family level. %>
	        <th class="firstCell emphasis"><%= t(".general_groups") %><%
	            if entity.entity_group %> <%= t(".for_family", family: entity.entity_group.name) %><% end %>:</th>
	        <th>
	        	<div class="flex space-between">
	        		<%= render partial: "reports/general_report_buttons", locals: { entities: entity.code } %>
	  			</div>
		    </th>
	    </tr>
	    <% end %>
	</tbody>
</table>

<% report_groups.each do |group| %>

	<%= render partial: "reports/report-modal", locals: {group: group} %>

<% end %>
