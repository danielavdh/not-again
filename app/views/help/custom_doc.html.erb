<%# Every released custom language's easy_manual/pro_manual/legal. @custom_doc names which (Language::DOC_FIELDS), @custom_doc_html is the converted, sanitised content. Terms has its own partial — it is never a full page. %>
<%= render "help/back" %>

<% if %w[easy_manual pro_manual].include?(@custom_doc) %>
  <div class="guide">
    <%= raw @custom_doc_html %>
  </div>
<% else %>
  <%= raw @custom_doc_html %>
<% end %>

<%# The EU declaration is an uploaded Document, not translatable text, so it is appended exactly as the static legal templates render it. %>
<% if @custom_doc == "legal" %>
  <% if @eu_declaration %>
    <section id="eu-declaration">
      <h2><%= t("welcome.legal.eu_declaration") %></h2>
      <p><%= link_to t("welcome.legal.eu_declaration_download"), @eu_declaration.doc_url %></p>
    </section>
  <% end %>

  <% if current_admin&.sudo? %>
    <section id="eu-declaration-upload">
      <h2><%= t("welcome.legal.eu_declaration") %></h2>
      <%= form_with url: documents_path, method: :post, local: true do %>
        <%= hidden_field_tag :kind, "eu_declaration_of_conformity" %>
        <%= file_field_tag :doc, accept: "application/pdf" %>
        <%= submit_tag(@eu_declaration ? t("welcome.legal.eu_declaration_replace") : t("welcome.legal.eu_declaration_upload"), class: "button green") %>
      <% end %>
    </section>
  <% end %>
<% end %>
