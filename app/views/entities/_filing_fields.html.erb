<%# locals: (authority:) %>

<%# One authority's filing details: whose books these are, and its identifier per business. Inside the entity form so one Save covers the page. Nothing here names HMRC — the authority arrives in `authority`, built from the catalogue headers. %>

<fieldset>
  <legend><%= authority[:name] %></legend>

  <div class="field">
    <%= label_tag "filing_#{authority[:key]}_taxpayer_id",
                  t("filing.register.taxpayer_label", authority: authority[:name]) %>
    <%= select_tag "filing[#{authority[:key]}][taxpayer_id]",
                   options_from_collection_for_select(authority[:choices], :id, :display_name,
                                                      authority[:taxpayer]&.id),
                   include_blank: t("filing.register.taxpayer_none"),
                   id: "filing_#{authority[:key]}_taxpayer_id",
                   data: { taxpayer_picker: authority[:key] } %>
    <%# Setting a client up without losing everything else ticked here. Saves at most a TAXPAYER; the tax setup still waits for the page's one Save. %>
    <button type="button" class="button add-taxpayer"
            data-taxpayer-add="<%= authority[:key] %>"
            data-url="<%= choose_taxpayers_path(authority: authority[:key]) %>">
      <%= t("filing.register.choose_or_add") %>
    </button>

    <%# Said here because nothing downstream can catch it: accounts carry no taxpayer, so two people's books in one entity would file under one number with no error anywhere. %>
    <p class="hint">
      <%= t("filing.register.taxpayer_hint", authority: authority[:name]) %>
      <%= link_to t("filing.register.manage"), taxpayers_path(return_to: authority[:return_to]) %>
    </p>
  </div>

  <%# NOT a free-text box before connecting: nobody knows their identifier until the authority says it, and an empty box invites the nearest number to hand. %>
  <% if authority[:taxpayer].nil? %>
    <p class="hint" data-taxpayer-pending="<%= authority[:key] %>"><%= t("filing.register.choose_taxpayer_first") %></p>

  <% elsif !authority[:taxpayer].connected? %>
    <p class="hint"><%= t("filing.register.connect_first", authority: authority[:name]) %></p>

  <% else %>
    <% authority[:groups].each do |group| %>
      <% offered = authority[:offered][group.id] || [] %>
      <div class="field">
        <%= label_tag "filing_#{authority[:key]}_business_#{group.tax_scheme}",
                      t("filing.#{authority[:key]}.business_id_label",
                        scheme: group.scheme_label,
                        default: "%{scheme} business ID") %>

        <%# The authority's own names do not tell its businesses apart. No field at all — a choice between two indistinguishable things is a coin toss, and losing it is silent. %>
        <% if authority[:blocked_schemes].include?(group.tax_scheme) %>
          <p class="hint">
            <%= t("filing.register.business_names_not_unique", authority: authority[:name]) %>
            <% if authority[:name_help_url] %>
              <%= link_to t("filing.register.business_names_fix"),
                          authority[:name_help_url], rel: "noopener", target: "_blank" %>
            <% end %>
          </p>

        <% elsif offered.any? %>
          <%# Several are possible for self-employment: each trade is its own business on the form. %>
          <%= select_tag "filing[#{authority[:key]}][business_ids][#{group.tax_scheme}]",
                         options_for_select(
                           offered.map { |b| [ [ b["tradingName"], b["businessId"] ].compact.reject(&:blank?).join(" — "),
                                               b["businessId"] ] },
                           group.business_id),
                         include_blank: t("filing.register.business_prompt"),
                         id: "filing_#{authority[:key]}_business_#{group.tax_scheme}" %>
        <% elsif authority[:businesses][group.tax_scheme].present? %>
          <%# The authority answered and every business it named is already claimed by another group. Nothing left to choose. %>
          <p class="hint"><%= t("filing.register.business_all_claimed", authority: authority[:name]) %></p>

        <% else %>
          <%# The authority could not be reached: keep what is stored visible and editable rather than offering an empty list. %>
          <%= text_field_tag "filing[#{authority[:key]}][business_ids][#{group.tax_scheme}]",
                             group.business_id,
                             id: "filing_#{authority[:key]}_business_#{group.tax_scheme}" %>
          <p class="hint"><%= t("filing.register.business_unavailable", authority: authority[:name]) %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>

</fieldset>
