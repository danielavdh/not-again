<% content_for :title, t("crud.edit") + " " + t("jargon.report") %>

<div id="new_edit_view">

    <h2><%= t("crud.edit") + " " + t("jargon.report") %> (<%= @report.name %>)</h2>

  <%= render partial: 'shared/flash' %>

  <%= form_with model: @report, 
                #url: report_path(@report), 
                method: :patch,
                class: "form_report" do |f| %>

    <% if @report.errors.any? %>
      <div class="field">
        <ul>
          <% @report.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name, t("attrs.name") %>
      <%= f.text_field :name, required: true %>
    </div>

    <div class="field flex">
      <div>
        <%= f.label :start_date, t("attrs.start_date") %>
        <%= f.date_field :start_date, required: true %>
      </div>
      <div>
        <%= f.label :end_date, t("attrs.end_date") %>
        <%= f.date_field :end_date, required: true %>
      </div>
    </div>

    <%# The same two fields as on a new report, so a wrong or forgotten rate can
        be put right. A final report refuses the change (Report). %>
    <% if @report.report_group.flat_rate? %>
      <div class="field">
        <%= f.label :flat_rate_percentage, t("tax.vat.flat_rate_label") %>
        <%= f.number_field :flat_rate_percentage, min: 0.01, max: 100, step: 0.01,
                           placeholder: @report.previous_in_group&.flat_rate_percentage&.to_s || t("tax.vat.flat_rate_placeholder") %>
      </div>
    <% end %>
    <% if (prepayment = @report.report_group.prepayment_category) %>
      <div class="field">
        <%= f.label :prepayment_display, "#{prepayment.reference} — #{prepayment.label}" %>
        <%= f.number_field :prepayment_display, min: 0, step: 0.01 %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit (@report.persisted? ? t("crud.update") : t("crud.create")) + " " + t("jargon.report") %>
    </div>

  <% end %>
</div>

<div class="crud_navigation">
  <%= link_to t("crud.reports"), 
  		reports_path, 
		class: "backend_link button green" %>
  <%= link_to t("crud.show") + " " + t("jargon.report"), 
  		report_path(@report), 
		class: "backend_link button green" %>
</div>
