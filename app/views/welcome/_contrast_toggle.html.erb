<%# A plain form post, so it works with JavaScript off — as an accessibility control should. Flips the cookie; the profile page has the full three-way. %>
<%= form_with url: contrast_path, method: :post, class: "contrast-toggle" do %>
  <%= hidden_field_tag :on, cookies[:high_contrast] == "1" ? "0" : "1" %>
  <button type="submit" aria-label="<%= t("welcome.index.footer_contrast") %>">
    <svg aria-hidden="true" focusable="false"><use href="#contrast" /></svg>
  </button>
<% end %>
