<%# Shared by every released custom language, for easy_manual/pro_manual/
    legal alike — see WelcomeController#localized_doc. @custom_doc names
    which one (Language::DOC_FIELDS' keys), @custom_doc_html is that row's
    own content, already converted from Textile and sanitized
    (Language#rendered_doc). Terms has its own partial, help/_terms_text —
    it is never a full page on its own. %>
<%= render "help/back" %>

<% if %w[easy_manual pro_manual].include?(@custom_doc) %>
  <div class="guide">
    <%= raw @custom_doc_html %>
  </div>
<% else %>
  <%= raw @custom_doc_html %>
<% end %>

<%# The EU declaration is a real uploaded Document, not translatable text —
    no custom Textile field could reproduce it, so it is appended here
    exactly as the static per-locale legal_*.html.erb templates render it,
    rather than being something sudo has to account for in their own
    content. %>
<% if @custom_doc == "legal" %>
  <% if @eu_declaration %>
    <section id="eu-declaration">
      <h2><%= t("welcome.legal.eu_declaration") %></h2>
      <p><%= link_to t("welcome.legal.eu_declaration_download"), @eu_declaration.doc_url %></p>
    </section>
  <% end %>

  <% if current_admin&.sudo? %>
    <section id="eu-declaration-upload">
      <h2><%= t("welcome.legal.eu_declaration") %></h2>
      <%= form_with url: documents_path, method: :post, local: true do %>
        <%= hidden_field_tag :kind, "eu_declaration_of_conformity" %>
        <%= file_field_tag :doc, accept: "application/pdf" %>
        <%= submit_tag(@eu_declaration ? t("welcome.legal.eu_declaration_replace") : t("welcome.legal.eu_declaration_upload"), class: "button green") %>
      <% end %>
    </section>
  <% end %>
<% end %>
