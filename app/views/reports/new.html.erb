<% content_for :title, "New Report" %>

<div id="new_edit_view">
  <%= render partial: 'shared/flash' %>

  <%= form_with model: @report, 
                url: report_group_reports_path(@report_group), 
                class: "form_report" do |f| %>

    <% if @report.errors.any? %>
      <div class="field">
        <ul>
          <% @report.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, required: true, placeholder: "e.g. Q1 2026" %>
    </div>

    <div class="field flex">
      <div>
        <%= f.label :start_date %>
        <%= f.date_field :start_date, required: true %>
      </div>
      <div>
        <%= f.label :end_date %>
        <%= f.date_field :end_date, required: true %>
      </div>
    </div>

    <% if @report_group&.vat_report? %>
      <div class="field">
        <%= f.label :flat_rate_percentage, t("tax.vat.flat_rate_label") %>
        <%= f.number_field :flat_rate_percentage, min: 0.01, max: 100, step: 0.01,
                           placeholder: t("tax.vat.flat_rate_placeholder") %>
      </div>
    <% end %>
    <%# A prepayment the authority fixed and the return deducts — a figure on the
        return, not a transaction. Only a scheme whose catalogue names the box
        (Germany's Kz 39) asks for it, in the authority's own words. %>
    <% if (prepayment = @report_group&.prepayment_category) %>
    	<div class="field">
    		<%= f.label :prepayment_display, "#{prepayment.reference} — #{prepayment.label}" %>
    		<%= f.number_field :prepayment_display, min: 0, step: 0.01 %>
    	</div>
    <% end %>

    <div class="actions">
      <%= f.submit "Create Report" %>
    </div>
  <% end %>
</div>

<div class="crud_navigation">
  <%= link_to "← Back", report_group_path(@report_group), class: "backend_link button green" %>
  <%= link_to "Cancel", report_group_path(@report_group), class: "backend_link button green" %>
</div>
