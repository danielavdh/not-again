<%= form_with model: currency,
              url: currency.persisted? ? currency_path(currency) : currencies_path,
              local: true,
              id: "#{action_name}_currency",
              class: 'form_currency' do |f| %>

	<%# ⚠️ Rails does not emit this. Without it every submit carries the row's current lock_version, the optimistic lock can never fire, and CurrenciesController#update's StaleObjectError rescue is unreachable. %>
	<%= f.hidden_field :lock_version if currency.persisted? %>

	<%# Settled = a POSTING carries it (narrower than #in_use?; an account alone does not lock it). A currency is GLOBAL. %>
	<% locked = currency.persisted? && currency.settled? && !sudo? %>

	<div class="field flex">
		<div>
			<%= f.label :code, t("currencies.form.code") %>
			<span class="error_message"><%= currency.errors[:code].to_sentence %></span><br />
			<%# Three letters, ISO. Uppercased on save. %>
			<%# Editing anyway cascades to every account, posting and rate carrying it — the lock is against two different currencies colliding, not against fixing a typo. %>
			<%= f.text_field :code, 
							maxlength: 3, 
							required: true, 
							autocapitalize: "characters",
							placeholder: "EUR",
			                readonly: locked, 
							disabled: locked %>
		</div>
		<div>
			<%= f.label :symbol, t("currencies.form.symbol") %>
			<span class="error_message"><%= currency.errors[:symbol].to_sentence %></span><br />
			<%# A currency with no distinct sign uses its code plus a trailing space, as CHF does. %>
			<%= f.text_field :symbol, 
							required: true,
							placeholder: "€", 
							readonly: locked, 
							disabled: locked %>
		</div>

	</div>


	<% if locked %>
		<p class="hint"><%= t("currencies.form.locked_hint") %></p>
	<% else %>
		<p class="hint"><%= t("currencies.form.coverage_hint") %></p>
	<% end %>

  <div class="actions">
      <%= f.submit t("currencies.save") %>
  </div>
<% end %>
