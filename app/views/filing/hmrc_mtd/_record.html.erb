<%# locals: (business:, filed:, authority:) %>

<%# HMRC's own record of the business, read back from Business Details and the
    cumulative period summary. Shown so the trade the figures land against is
    visible, and so "did my last submission arrive?" is answerable here.

    The VALUES are HMRC's, shown exactly as HMRC holds them and deliberately not
    translated — this panel is their record, and paraphrasing it would defeat the
    point of showing it. Only the row labels are translated. %>
<details>
	<summary><%= t("filing.hmrc.hmrc_record", authority: authority) %></summary>

	<table>
		<tbody>
			<% business.each do |key, value| %>
				<tr>
					<td><%= t("filing.hmrc.business.#{key}") %></td>
					<td><%= value %></td>
				</tr>
			<% end %>

			<% if filed && filed[:submitted_on].present? %>
				<tr class="parent-row">
					<td><%= t("filing.hmrc.last_submitted", authority: authority) %></td>
					<td><%= filed[:submitted_on] %></td>
				</tr>
			<% end %>
		</tbody>
	</table>
</details>
