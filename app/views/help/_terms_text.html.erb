<%# Shared by gates/terms_show and admin_mailer/terms_agreed. A released custom language's terms_textile wins, then the shipped partial for this locale, then English. File.exist? rather than template_exists? — this renders inside a mailer too. %>
<% custom_html = Language.custom_doc_html("terms", I18n.locale) %>
<% if custom_html %>
  <%= raw custom_html %>
<% else %>
  <% locale_partial = "terms_text_#{I18n.locale}" %>
  <% locale_partial = "terms_text_en" unless File.exist?(Rails.root.join("app/views/help/_#{locale_partial}.html.erb")) %>
  <%= render "help/#{locale_partial}" %>
<% end %>
