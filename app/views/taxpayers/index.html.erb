<% content_for :title, t("filing.register.title") %>

<div class="backend_table">
  <%= render partial: 'shared/flash' %>

  <h1><%= t("filing.register.title") %></h1>
  <p class="hint light"><%= t("filing.register.intro") %></p>

  <% if @taxpayers.any? %>
    <table >
      <thead>
        <tr>
          <th><%= t("filing.register.name") %></th>
          <th><%= t("filing.register.authority") %></th>
          <th><%= t("filing.register.created_by") %></th>
          <th><%= t("filing.register.tax_id") %></th>
          <th><%= t("filing.register.report_groups") %></th>
          <th><%= t("filing.register.connection_state") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @taxpayers.each do |taxpayer| %>
          <tr class="<%= cycle('list-line-odd', 'list-line-even') %>">
            <td><%= taxpayer.display_name %></td>
            <td><%= taxpayer.authority_name %></td>
            <td><%= taxpayer.admin&.username || "—" %></td>
            <%# Not a secret — it identifies, it does not grant — but a list of full NINOs is still not something to leave on screen. %>
            <td><%= taxpayer.identifier_keys.filter_map { |k| taxpayer.masked_identifier(k) }.join(", ").presence || "—" %></td>
            <%# Entity code included because two groups of the same scheme — two trades, one person — would otherwise read alike. %>
            <td><%= taxpayer.report_groups.map { |g| "#{g.entity.code} · #{g.display_name}" }.sort.join(", ").presence || "—" %></td>
            <td>
              <%= taxpayer.connected? ?
                    t("filing.connected_label",
                      expires: taxpayer.token_expires_at && "#{l(taxpayer.token_expires_at, format: :short_date)} #{taxpayer.token_expires_at.strftime('%H:%M')}") :
                    t("filing.not_connected_label") %>
            </td>
            <%# Shared ones appear because they file for an entity you can write to, so you may use and connect them. The record stays with whoever set the client up. %>
            <td>
              <% if taxpayer.admin_id == current_admin.id %>
                <%= link_to t("crud.edit"), edit_taxpayer_path(taxpayer, return_to: params[:return_to]),
                            class: "backend_link button green" %>
                <%= button_to t("crud.delete"), taxpayer_path(taxpayer, return_to: params[:return_to]),
                              method: :delete,
                              data: { sure: t("filing.register.delete_confirm",
                                              name: taxpayer.display_name) },
                              class: "backend_link button red" %>
              <% else %>
                <span class="hint"><%= t("filing.register.shared") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint"><%= t("filing.register.none") %></p>
  <% end %>
</div>

<div class="crud_navigation">
  <%= link_to t("filing.register.add"), new_taxpayer_path(return_to: params[:return_to]),
              class: "backend_link button green" %>
  <%= link_to t("crud.back"), @back_path, class: "backend_link button green" %>
</div>
