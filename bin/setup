#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  # Rails does not need credentials in development — it falls back to a secret in
  # tmp/local_secret.txt. But that file is thrown away by tmp:clear below, taking
  # every session with it, and you will need credentials for production anyway.
  # So create them now, with nothing in them but the generated secret_key_base.
  #
  # EDITOR=true opens no editor: `true` is a command that exits immediately, so
  # Rails writes config/master.key and config/credentials.yml.enc, finds nothing
  # changed, and re-encrypts. Add real values later with `bin/rails credentials:edit`.
  unless File.exist?("config/master.key")
    puts "\n== Creating credentials =="
    system!({ "EDITOR" => "true" }, "bin/rails credentials:edit")
    puts "   config/master.key created. Back it up somewhere that is not this computer."
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # The first admin, which cannot be made from inside the app: every page needs a
  # login and only a full-access admin can add people. `install:owner` refuses if
  # an admin already exists, so ask first rather than let a re-run fail here.
  puts "\n== The first admin =="
  if system("bin/rails runner 'exit(Admin.exists? ? 0 : 1)'", out: File::NULL, err: File::NULL)
    puts "   Skipped — this installation already has an admin."
  else
    system! "bin/rails install:owner"
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
