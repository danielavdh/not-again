<%# locals: (business:, filed:, authority:) %>

<%# HMRC's own record, read back from Business Details and the cumulative period summary — so the trade the figures land against is visible. The VALUES are HMRC's and deliberately untranslated; only the row labels are. %>
<details>
	<summary><%= t("filing.hmrc.hmrc_record", authority: authority) %></summary>

	<table>
		<tbody>
			<% business.each do |key, value| %>
				<tr>
					<td><%= t("filing.hmrc.business.#{key}") %></td>
					<td><%= value %></td>
				</tr>
			<% end %>

			<% if filed && filed[:submitted_on].present? %>
				<tr class="parent-row">
					<td><%= t("filing.hmrc.last_submitted", authority: authority) %></td>
					<td><%= filed[:submitted_on] %></td>
				</tr>
			<% end %>
		</tbody>
	</table>
</details>
