<% content_for :title, t("entities.edit_tax.title", name: @entity.name) %>

<div id="new_edit_view">

  <%= render partial: 'shared/flash' %>

  <% if @entity.errors.any? %>
    <p class="error_message"><%= @entity.errors.full_messages.to_sentence %></p>
  <% end %>

  <h1><%= t("entities.edit_tax.title", name: @entity.name) %></h1>
  <p class="hint light"><%= t("entities.edit_tax.intro") %></p>
  <p class="hint light"><%= t("entities.edit_tax.assign_signpost_html",
                        accounts: link_to(t("page.accounts"), accounts_path)) %><br />
  				  <%= t("entities.edit_tax.bulk_assign_signpost") %></p>

  <%= form_with model: @entity,
                url: update_tax_entity_path(@entity),
                method: :patch,
                id: "edit_tax_entity",
                class: "form_entity" do |f| %>

    <div class="field" id="entity-tax-schemes-field">
      <h2><%= t("tax.schemes_hint") %></h2>

      <span class="error_message"><%= @entity.errors[:tax_schemes].to_sentence %></span><br />

      <%= hidden_field_tag "entity[tax_schemes][]", "" %>

      <% @schemes_by_country.each do |country, schemes| %>
        <fieldset>
          <legend><%= t("tax.country.#{country}", default: country.upcase) %></legend>
          <% schemes.each do |scheme| %>
            <% authority_key, authority_name = @authority_by_scheme[scheme] %>
            <div>
              <%# data-authority only on schemes that CAN be filed from here, so
                  the question is asked once per authority and never for a scheme
                  that only ever gets tagged and exported. The sentence comes with
                  it, already naming the authority, so the script has no text of
                  its own. %>
              <%= check_box_tag "entity[tax_schemes][]", scheme,
                        Array(@entity.tax_schemes).include?(scheme),
                        id: "entity_tax_scheme_#{scheme}",
                        data: { authority: authority_key,
                                submit_question: (t("filing.register.submit_question",
                                                    authority: authority_name) if authority_key) } %>
              <label>
                <%= @scheme_labels[scheme] %>
              </label>
              <% if (group = @tax_groups_by_scheme[scheme]) %>
                <%= link_to group.display_name, report_group_path(group),
                            class: "backend_link button green" %>
              <% end %>
            </div>
          <% end %>
        </fieldset>
      <% end %>

    </div>

    <%# Whose books these are, at each authority that can file them. Inside the
        form, so the page has ONE Save — two forms meant unticking a scheme and
        then clicking the nearer Save silently discarded the change.

        Ticking a submittable scheme asks the question below and, on yes, fetches
        another of these into #filing-fields. Saved and pending blocks are the
        same partial and post the same fields, so the one Save covers both. %>
    <div id="filing-fields" data-url="<%= filing_fields_entity_path(@entity) %>">
      <% @filing_authorities.each do |authority| %>
        <%= render "entities/filing_fields", authority: authority %>
      <% end %>
    </div>

    <%# The question a ticked scheme asks is a confirm(), not markup: it has to be
        answered before anything else happens, and a block appearing further down
        the page can be walked past — you could then Save a return that files from
        the app with nobody to file it for. Same convention as data-sure.
        The sentence lives in acc.filing.register.submit_question; tax.js reads it
        from the checkbox. %>

    <%# An extra file for the accountant, alongside the universal transactions
        CSV. DATEV is a German and Austrian convention; other countries' formats
        can join the list. Not derived from anywhere — it is what this entity's
        accountant asked for. %>
    <div class="field accountant-export">
      <%= f.label :accountant_export, t("tax.accountant_export_field") %>
      <%# From the registry, so adding a format never means editing this view.
          Reads "Standard CSV" / "add DATEV" — the standard files always go, so
          every entry here is something EXTRA rather than an alternative. %>
      <%= f.select :accountant_export,
                   accountant_export_options,
                   { include_blank: t("tax.accountant_export_none") } %>
      <p><%= t("tax.accountant_export_hint") %></p>
    </div>

    <div class="actions">
      <%= f.submit t("entities.edit_tax.save") %>
    </div>

  <% end %>

  <%# The connection controls, one per authority. Outside the form: the
      Disconnect button is a button_to, which renders a <form>. Empty for an
      entity whose schemes all stop at tagging and export — the normal case. %>
  <% @filing_authorities.each do |authority| %>
    <%= render "entities/filing_authority", authority: authority, entity: @entity %>
  <% end %>

  <div class="crud_navigation">
    <%# Back to the dashboard, not to the admin page: this page is reached from
        the entity's own block on the dashboard now, since tax setup belongs to
        the entity rather than to the admin. %>
    <%= link_to t("crud.back"), dashboard_path, class: "backend_link button green" %>
  </div>

  <%# Setting a client up without leaving the page. The form is fetched from
      TaxpayersController#new in modal mode and posted by JS; on success the new
      taxpayer joins the picker it was opened from. Only the TAXPAYER is saved —
      a record of its own — so the tax setup still waits for the page's one Save.

      Outside the entity form, deliberately: it contains a form, and forms cannot
      nest. %>
  <dialog id="add-taxpayer-modal" class="split-modal">
    <div class="split-modal-box">
      <h3><%= t("filing.register.add") %></h3>
      <p id="add-taxpayer-errors" class="split-warning" hidden></p>
      <div id="add-taxpayer-content"></div>
    </div>
  </dialog>

</div>
