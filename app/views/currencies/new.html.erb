<% content_for :title, t("currencies.new_title") %>

<div id="new_edit_view">

    <% if @currency.errors.any? %>
    <p class="error_message"><%= t("crud.errors_on_page") %></p>
    <% end %>

    <h1><%= t("currencies.new_title") %></h1>
  	<%= render partial: 'shared/flash' %>

    <%= render 'form', currency: @currency %>

    <div class="crud_navigation">
        <%= link_to t("crud.currency"), currencies_path, class: "backend_link" %>
    </div>

</div>

