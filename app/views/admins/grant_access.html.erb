<div id="new_edit_view">

    <%= render partial: "shared/flash" %>

    <% if @admin.errors.any? %>
    <p class="error_message"><%= t("admins.new.errors_on_page") %></p>
    <% end %>

    <h1><%= t(".title") %></h1>

    <%# Sudo has no level to choose, so the sentence can name it. A full-access
        admin picks one from the select below, which would make an interpolated
        level go stale the moment they changed it. %>
    <p class="info"><%= sudo? ? t(".hint_sudo") : t(".hint") %></p>

    <%= render "grant_form", admin: @admin %>

    <div class="crud_navigation">
    <% if sudo? %>
        <%= link_to t("admins.new.index"), admins_path, class: "backend_link" %>
    <% else %>
        <%= link_to t("crud.back"), admin_path(current_admin), class: "backend_link" %>
    <% end %>
    </div>

</div>
