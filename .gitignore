# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# The encrypted secret store stays OUT of this repo — it is public. It is still
# copied into the Docker image (.dockerignore does not exclude it) and Kamal
# supplies RAILS_MASTER_KEY, so deploys work; a stranger cloning this runs
# `bin/rails credentials:edit` and gets their own. Backed up to iCloud, since
# git is no longer doing it.
/config/credentials.yml.enc

/akten
/public/media/
/public/system/
/public/uploads/
/public/assets/
/public/tax_submissions/

/docs/gitignored

# No need to expose development.rb

.DS_Store
# NOTE: development.rb, test.rb and .ruby-version used to be ignored. They are
# not any more. Ignoring them meant every CI run died before it started, and a
# fresh clone could boot in neither dev nor test. development.rb was additionally
# a symlink into iCloud purely so it would get BACKED UP — git does that now.
# Nothing in them is secret; credentials are referenced, never inlined.

.ruby-gemset

/app/assets/builds/*
!/app/assets/builds/.keep

/lib/tasks/dev.rake

 # exclude all databasse dumps
*.dump

Procfile.dev

.kamal/secrets

Claude.local.md

# Personal Claude Code overrides — machine-specific paths, never team-wide.
.claude/settings.local.json

# ⚠️ A STANDING GUARD, not a leftover. The Dutch SBR taxonomy packages are
# ~1.7GB of XBRL schemas, and git cannot forget a blob once it has one. They
# were downloaded, read, extracted and deleted — but anyone re-downloading them
# to re-read the taxonomy would otherwise be one `git add .` from a permanently
# enormous repository.
#
# What is checked in instead are the readable extracts, ~12KB each:
#   docs/tax-forms/nl-winstaangifte-resultatenrekening-nt20.md
#   docs/tax-forms/VAT/nl-omzetbelasting-aangifte-nt20.md
# Both name the exact package and version they came from.
docs/tax-forms/gitignored/*

# The real deployment config: hostnames and server addresses of a running
# installation. Copy config/deploy.example.yml to create it.
config/deploy.yml

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

