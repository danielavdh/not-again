<% content_for :title, t("page.journal_entries") %>

<div class="backend_table">
  <h2><%= t("page.journal_entries") %></h2>

  <%= render partial: 'shared/flash' %>

  <div class="controls">
    <%= link_to t("crud.new_entry"),
        new_journal_entry_path,
        class: 'backend_link button green' %>
    <%= link_to t("crud.csv"),
        journal_entries_path(format: :csv, search: params[:search], start_date: params[:start_date], end_date: params[:end_date]),
        target: "_blank", rel: "noopener",
        class: 'backend_link button green',
        data: { sure: t("crud.csv_confirm") } %>

  	<div class="je-filter">
  	  <input type="text"
  	         id="je-filter-input"
  	         aria-label="<%= t('.search_placeholder') %>"
  	         placeholder="<%= t(".search_placeholder") %>"
  	         value="<%= params[:search] %>"
  	         autocomplete="off" />
  	  <label for="je-filter-from"><%= t(".from_date") %>:</label>
  	  <input type="date" id="je-filter-from" value="<%= params[:start_date] %>" />
  	  <label for="je-filter-to"><%= t(".to_date") %>:</label>
  	  <input type="date" id="je-filter-to" value="<%= params[:end_date] %>" />
  	</div>

    <% if @pagy %>
      <%== @pagy.series_nav %>
    <% end %>

  </div>

  <table>
    <thead>
      <tr>
        <th class="no-phone">ID</th>
        <th><%= t("attrs.date") %></th>
        <th><%= t("jargon.balance") %> <%= t("jargon.account") %></th>
        <th class="no-phone"><%= t("attrs.memo") %></th>
        <th class="no-phone"><%= t("attrs.je_ref") %></th>
        <th class="right"><%= t("attrs.amount") %></th>
        <th class="no-phone"><%= t("attrs.status") %></th>
        <th class="no-print no-phone"><%= t("attrs.actions") %></th>
      </tr>
    </thead>
    <tbody id="je-table-body">
      <%= render partial: 'journal_entries/journal_entry_rows',
                 locals: {
                   journal_entries: @journal_entries,
                   balance_account: @balance_account,
                   credit_sums: @credit_sums,
                   credit_currency: @credit_currency,
                   cross_entity_je_ids: @cross_entity_je_ids,
                   app_owned_close_ids: @app_owned_close_ids
                 } %>
    </tbody>
  </table>

</div>
